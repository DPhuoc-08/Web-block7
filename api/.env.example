# Sao chép file này thành .env rồi điền chuỗi kết nối thật (không commit .env).
# Supabase → Connect → Session pooler, cổng 5432. Dùng project Supabase RIÊNG của block7
# (seed xoá sạch database đang trỏ tới — không trỏ vào database của block5/block6).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:5432/postgres"
PORT=3000

# Origin của SPA được phép gọi API (không có dấu / cuối, không dùng *)
CORS_ORIGIN=http://localhost:5173

# Bật để in từng câu SQL thật (kèm tham số) ra terminal của API — dùng làm bằng chứng nộp. Mặc định tắt.
# LOG_SQL=1
