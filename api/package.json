{
  "name": "block7-api",
  "version": "1.0.0",
  "description": "REST API cho ứng dụng nhà hàng: Express + Prisma + Supabase, có phân trang và tìm kiếm (basic, advanced, full-text, fuzzy)",
  "main": "src/app.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
